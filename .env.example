# === Infraestrutura ===
# DATABASE_URL, CHECKPOINT_DIR e DATA_DIR têm defaults portáveis no código
# (relativos à raiz do repo) e são injetados pelo docker-compose no Docker.
# Defina-os aqui apenas se quiser sobrescrever os caminhos.
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# Conexão configurável sem Docker. Default já é um SQLite portátil
# em <repo>/data/pipeline.db; troque o caminho/arquivo aqui se desejar.
# DATABASE_URL=sqlite:///./data/pipeline.db

# === Tickers (yfinance) ===
YFINANCE_TICKERS=BBAS3.SA,ITUB4.SA,BBDC4.SA,SANB11.SA

# === Período de análise (ISO YYYY-MM-DD) ===
DATE_START=2025-01-01
DATE_END=2025-12-31

# === Datas macro do Banco Central ===
# Selic usa DD/MM/YYYY; dólar (PTAX) usa MM-DD-YYYY.
DATA_INICIAL_SELIC=01/01/2025
DATA_FINAL_SELIC=31/12/2025
DATA_INICIAL_DOLAR=01-01-2025
DATA_FINAL_DOLAR=12-31-2025

# === Endpoints do Banco Central ===
API_BCB_SELIC=https://api.bcb.gov.br/dados/serie/bcdata.sgs.11/dados?formato=json&dataInicial=${DATA_INICIAL_SELIC}&dataFinal=${DATA_FINAL_SELIC}
API_BCB_DOLAR=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/CotacaoDolarPeriodo(dataInicial=@dataInicial,dataFinalCotacao=@dataFinalCotacao)?@dataInicial=%27${DATA_INICIAL_DOLAR}%27&@dataFinalCotacao=%27${DATA_FINAL_DOLAR}%27&$top=10000&$format=json&$select=cotacaoCompra,cotacaoVenda,dataHoraCotacao

# === LLM para tratamento de notícias ===
# Escolhe o adapter: "local" (HuggingFace Transformers) ou "api" (Pydantic AI).
LLM_BACKEND=api

# Provider/modelo da nuvem quando LLM_BACKEND=api (Pydantic AI multiprovider).
LLM_API_PROVIDER=anthropic
LLM_API_MODEL=claude-sonnet-4-6

# Pasta de cache dos modelos locais (ignorada por git/docker). Download sob demanda.
LLM_MODELS_DIR=llm-models

# Catálogo de modelos locais por VRAM (JSON, sem nomes hardcoded).
# Campos: name, path, vram e, opcionalmente, "repo" (id do HuggingFace).
LLM_MODELS=[{"name":"DeepSeek R1 Distill-Qwen-7B","path":"llm-models/deepseek-r1-distill-qwen-7b","repo":"deepseek-ai/DeepSeek-R1-Distill-Qwen-7B","vram":"4 GB"},{"name":"Qwen3-4B","path":"llm-models/qwen3-4b","repo":"Qwen/Qwen3-4B","vram":"8 GB"}]
